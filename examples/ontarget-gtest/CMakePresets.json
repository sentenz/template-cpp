{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Native host tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_EMBEDDED": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "stm32f407",
      "displayName": "STM32F407VG on-target tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/stm32f407",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "BUILD_EMBEDDED": "ON",
        "BUILD_TESTING": "ON",
        "ENABLE_JRUN_TESTS": "ON",
        "JRUN_DEVICE": "STM32F407VG",
        "JRUN_INTERFACE": "SWD",
        "JRUN_SPEED_KHZ": "4000",
        "JRUN_TIMEOUT_SECONDS": "60"
      }
    },
    {
      "name": "stm32f407-build-only",
      "inherits": "stm32f407",
      "binaryDir": "${sourceDir}/build/stm32f407-build-only",
      "cacheVariables": {"ENABLE_JRUN_TESTS": "OFF"}
    }
  ],
  "buildPresets": [
    {"name": "host", "configurePreset": "host"},
    {"name": "stm32f407", "configurePreset": "stm32f407"},
    {"name": "stm32f407-build-only", "configurePreset": "stm32f407-build-only"}
  ],
  "testPresets": [
    {"name": "host", "configurePreset": "host",
     "output": {"outputOnFailure": true}},
    {"name": "stm32f407", "configurePreset": "stm32f407",
     "output": {"outputOnFailure": true}, "execution": {"jobs": 1}}
  ]
}
